def stop_attest_agents(state, only=None):
    """Stop every attest agent, or just the one named `only` (`attest-5`, `subscribe-0`)."""
    for name, pid in sorted(attest_pids(state).items()):
        if only is not None and name != only: continue
        _kill(pid, name)

def wait_pool_fresh(state, want=None, timeout=90, node=USER):
    """Wait until `node`'s pool holds a fresh attestation from at least `want` seated attestors --
    what the mint path needs (attest.poolFresh >= M_SELECT)."""
    want = M_SELECT if want is None else want
    deadline, last = time.time() + timeout, None
    while True:
        last = rpc(state, node).yed_getinfo()["attest"]
        if last["poolFresh"] >= want: return last
        if time.time() > deadline:
            raise RuntimeError("node%d: poolFresh stayed at %d (< %d) for %ds; see %s/attest-*.log and subscribe-*.log"
                               % (node, last["poolFresh"], want, timeout, state["dir"]))
        time.sleep(1)

def seq_of(node_rpc, attestor_pubkey):
    """yed_registerattestor returns seq null until the registration confirms; resolve it by key."""
    for rec in node_rpc.yed_listattestors():
        if rec["attestorPubKey"] == attestor_pubkey: return int(rec["seq"])
    return None

def load(directory):
    try:
        with open(path(directory)) as file: state = json.load(file)
    except OSError: sys.exit("no devnet at %s (run `up` first)" % directory)
    PortSeed.n = state["portseed"]
    return state
def save(directory, state):
    tmp = path(directory) + ".tmp"
    with open(tmp, "w") as file: json.dump(state, file, indent=2)
    os.replace(tmp, path(directory))

def start_quiet(directory, node, arguments):
    import functools
    log = open(os.path.join(node_dir(directory, node), "ycashd.log"), "a")
    output, popen = os.dup(1), _util.subprocess.Popen
    _util.subprocess.Popen = functools.partial(popen, start_new_session=True, stdin=subprocess.DEVNULL)
    try:
        os.dup2(log.fileno(), 1)
        return start_node(node, directory, arguments, stderr=log)
    finally:
        _util.subprocess.Popen = popen
        os.dup2(output, 1); os.close(output); log.close()

def restart_node(state, node, arguments, label):
    """Stop `node` cleanly and start it again with `arguments` (recorded for the next restart)."""
    directory = state["dir"]
    if alive(state, node):
        try: rpc(state, node).stop()
        except Exception: pass
        deadline = time.time() + 60
        while alive(state, node):
            if time.time() > deadline: sys.exit("node%d did not stop within 60 s" % node)
            time.sleep(0.5)
        time.sleep(1)
    start_quiet(directory, node, arguments)
    state.setdefault("node_args", {})[str(node)] = arguments
    proxy = rpc(state, node)
    others = [n for n in range(state["num_nodes"]) if n != node and alive(state, n)]
    for other in others:
        try: proxy.addnode("127.0.0.1:%d" % _util.p2p_port(other), "onetry")
        except Exception: pass
    print("node%d restarted %s" % (node, label))


    if not app:
        app = os.path.join(WORKSPACE, "yecwallet-dd", "build", "macos-arm64", "bin", "yecwallet.app", "Contents", "MacOS", "yecwallet")
    return [app, "--conf", os.path.join(node_dir(directory, USER), "ycash.conf"), "--no-embedded"]

def wait(nodes):
    sync_blocks(nodes)
    for index in (USER,) + POOLS + tuple(a for a in ATTESTORS if a < len(nodes)):
        wait_yed_healthy(nodes[index])

def check(state, verbose=True):
    node = rpc(state, USER)
    activation, stats = node.yed_getactivation(), node.yed_getstats()
    expected = set(state["pool_addresses"])
    eligible = {row["payoutAddress"] for row in node.yed_listminers() if row["eligible"]}
    errors = []
    if activation["status"] != "active": errors.append("activation is %s" % activation["status"])
    if not stats["mintingAllowed"]: errors.append("minting is not allowed")
    if eligible != expected: errors.append("not all pools are eligible")
    if node.getbalance() <= 0: errors.append("node0 has no mature balance")
    if verbose: print("activation: %s; minting: %s; eligible pools: %d/%d; node0 balance: %s YEC" % (activation["status"], "yes" if stats["mintingAllowed"] else "no", len(eligible & expected), len(expected), node.getbalance()))
    if attestors_of(state):
        attest = node.yed_getinfo()["attest"]
        if attest["status"] != "ARMED": errors.append("attestation is %s, not ARMED" % attest["status"])
        if attest["poolFresh"] < M_SELECT:
            errors.append("poolFresh is %d, below M_SELECT (%d): no mint can build a bundle" % (attest["poolFresh"], M_SELECT))
        seated = attest["seatedCount"]
        if seated < ATTEST_ARM_MIN: errors.append("only %d attestors seated (need %d)" % (seated, ATTEST_ARM_MIN))
        dead = [name for name, pid in attest_pids(state).items() if not agent_alive(pid)]
        if dead: errors.append("attest agents not running: %s" % ", ".join(sorted(dead)))
        if verbose: print("attestation: %s; seated %d; poolFresh %d/%d; pool size %d; agents %d up"
                          % (attest["status"], seated, attest["poolFresh"], M_SELECT, attest["poolSize"],
                             len([1 for pid in attest_pids(state).values() if agent_alive(pid)])))
    if errors: raise RuntimeError("devnet check failed: " + "; ".join(errors))

def arm_attestors(state, nodes, price, steps=6):
    """Register nodes 5-7 as attestors, mine through BOND_MATURITY and ATTEST_ARM_DELAY so the
    devnet ends ARMED (ARM-1/ARM-2), then start one `attest` agent per attestor and one
    `subscribe` beside node 0 on the `dir` transport and wait for poolFresh >= M_SELECT.

    Registration is the wallet RPC each attestor runs for itself (yed_registerattestor), not a
    raw builder: this is the path a real attestor follows, and the devnet exists to demonstrate
    it.  Blocks are mined by the pools, round-robin, so every height keeps a tagged quote."""
    directory, attestors = state["dir"], attestors_of(state)
    pools = list(POOLS)
    def pool_mine(n, label):
        for block in range(n):
            nodes[pools[block % len(pools)]].generate(1); sync_blocks(nodes)
        wait(nodes)
        print("      %s -> height %d" % (label, nodes[USER].getblockcount()))

    print("[5/%d] registering %d attestors (%d YEC bonded for %d blocks each)"
          % (steps, len(attestors), ATTEST_BOND_YEC, ATTEST_LOCK_BLOCKS))
    for node in attestors:
        nodes[USER].sendtoaddress(nodes[node].getnewaddress(), ATTEST_FUND_YEC)
    # sync_blocks alone is not enough: the funding transactions must reach the pool that mines the
    # next block, and mempools are only synced explicitly (the third registration once found
    # "insufficient-yec: have 0.00" because its funding was still on node 0).
    sync_mempools(nodes); pool_mine(1, "funded the attestor wallets")
    for node in attestors:
        have = nodes[node].getbalance()
        if have < ATTEST_BOND_YEC:
            raise RuntimeError("node%d holds %s YEC after funding, needs %d" % (node, have, ATTEST_BOND_YEC))
    pubkeys = {}
    for node in attestors:
        result = nodes[node].yed_registerattestor(ATTEST_BOND_YEC, ATTEST_LOCK_BLOCKS)
        pubkeys[node] = result["attestorPubKey"]
        print("      node%d registered: txid %s, bond %s" % (node, result["txid"][:16], result["bondAddress"]))
    sync_mempools(nodes)
    pool_mine(1, "registrations confirmed")
    pool_mine(BOND_MATURITY, "bonds matured (BOND_MATURITY=%d)" % BOND_MATURITY)
    info = nodes[USER].yed_getinfo()["attest"]
    if info["status"] != "TRIGGERED":
        raise RuntimeError("attestation is %s after BOND_MATURITY, expected TRIGGERED "
                           "(%d of %d bonds mature)" % (info["status"], info["seatedCount"], len(attestors)))
    print("      TRIGGERED at height %d; arms at %d" % (info["triggerHeight"], info["armHeight"]))
    pool_mine(ATTEST_ARM_DELAY, "arming delay elapsed (ATTEST_ARM_DELAY=%d)" % ATTEST_ARM_DELAY)
    info = nodes[USER].yed_getinfo()["attest"]
    if info["status"] != "ARMED":
        raise RuntimeError("attestation is %s after ATTEST_ARM_DELAY, expected ARMED" % info["status"])
    seqs = {}
    for node in attestors:
        seq = seq_of(nodes[USER], pubkeys[node])
        if seq is None: raise RuntimeError("node%d's registration is not in yed_listattestors" % node)
        seqs[str(node)] = seq
    state["attest_seqs"] = seqs

    print("[6/%d] starting %d `attest` agents and one `subscribe`, dir transport at %s"
          % (steps, len(attestors), bus_path(directory)))
    os.makedirs(bus_path(directory), exist_ok=True)
    for node in attestors:
        write_attest_mock(directory, node, price)
        state["attest_agents"]["attest-%d" % node] = start_attest_agent(directory, node, seqs[str(node)])
    state["attest_agents"]["subscribe-%d" % USER] = start_subscriber(directory, USER)
    # The agents sign only at a due tick (every ATTEST_INTERVAL blocks), so mine into one.
    pool_mine(ATTEST_INTERVAL + REF_LAG, "mined into an attestation tick")
    info = wait_pool_fresh(state)
    print("      ARMED: %d seated, poolFresh %d, pool holds %d attestation(s)"
          % (info["seatedCount"], info["poolFresh"], info["poolSize"]))

def up(args):
    directory = os.path.abspath(args.dir)
    if os.path.exists(path(directory)):
        state = load(directory)
        if any(alive(state, node) for node in range(state["num_nodes"])): sys.exit("a devnet is already running in %s; `down` it first" % directory)
        if not args.force: sys.exit("%s holds a stopped devnet; pass --force to rebuild" % directory)
    elif os.path.exists(directory) and os.listdir(directory) and not args.force: sys.exit("%s exists and is not empty; pass --force" % directory)
    if os.path.exists(directory): shutil.rmtree(directory)
    binary = args.bitcoind or os.environ.get("BITCOIND") or os.path.join(REPO, "src", "ycashd")
    if not os.access(binary, os.X_OK): sys.exit("ycashd not found at %s" % binary)
    os.environ["BITCOIND"], PortSeed.n = binary, args.portseed
    attest = not args.no_attest
    count = ATTEST_NODES if attest else NODES
    attestors = list(ATTESTORS) if attest else []
    steps = 6 if attest else 4
    addresses = [address_of(wif) for wif in POOL_WIFS]
    pool_extra = ["-yellowbackquotemaxage=%d" % QUOTE_MAX_AGE] if args.agents else None
    node_args = [yellowback_node_args(), yellowback_node_args(yellowback=False)] + [pool_args(address, pool_extra) for address in addresses]
    node_args += [yellowback_node_args() for _ in attestors]      # attestor nodes: enforcing, no payout, no signal
    if args.agents and not os.access(AGENT, os.X_OK): sys.exit("quote agent not found at %s" % AGENT)
    if attest and not os.access(ATTEST_AGENT, os.X_OK):
        sys.exit("yellowback-attest not found at %s\n  build it with: cd %s && cargo build --release\n"
                 "  (or point YELLOWBACK_ATTEST_BIN at it, or run `up --no-attest` for the five-node v2 devnet)"
                 % (ATTEST_AGENT, ATTEST_CRATE))
    os.makedirs(directory); nodes = []; agents = {}; attest_agents = {}
    state = {"portseed": args.portseed, "bitcoind": binary, "num_nodes": count, "pools": list(POOLS),
             "pool_addresses": addresses, "price_usd": str(args.price), "agents": agents,
             "attestors": attestors, "attest_agents": attest_agents, "attest_seqs": {},
             "dir": directory, "created": time.strftime("%Y-%m-%d %H:%M:%S")}
    try:
        print("[1/%d] starting %d regtest nodes in %s" % (steps, count, directory))
        initialize_chain_clean(directory, count)
        nodes = [start_quiet(directory, index, node_args[index]) for index in range(count)]
        for left in range(count):
            for right in range(left + 1, count): connect_nodes_bi(nodes, left, right)
        for index, node in enumerate(POOLS): nodes[node].importprivkey(POOL_WIFS[index], "yellowback-payout", False)
        print("[2/%d] funding node0 with 101 untagged blocks" % steps)
        nodes[USER].generate(101); wait(nodes)
        if nodes[USER].getbalance() <= 0: raise RuntimeError("node0 has no mature balance")
        if args.agents:
            print("[3/%d] starting one yellowback-quote per pool at $%s (mock price %s)" % (steps, args.price, mock_path(directory)))
            write_mock(directory, args.price)
            for node in POOLS: agents[node] = start_agent(directory, node)
            wait_quotes(state)
        else:
            print("[3/%d] setting $%s quotes on pools 2-4" % (steps, args.price))
            for node in POOLS: set_quote(nodes[node], args.price)
        print("[4/%d] mining 131 signalling blocks round-robin across pools" % steps)
        for block in range(ACTIVATION_BLOCKS + 2):
            nodes[POOLS[block % len(POOLS)]].generate(1); sync_blocks(nodes)
        wait(nodes)
        if attest:
            arm_attestors(state, nodes, args.price, steps)
    except Exception:
        stop_agents(state); stop_attest_agents(state)
        for node in nodes:
            try: node.stop()
            except Exception: pass
        for index in list(bitcoind_processes):
            try: bitcoind_processes[index].wait(timeout=10)
            except Exception: pass
            del bitcoind_processes[index]
        raise
    save(directory, state); check(state, False)
    print("ready at height %d: node0 has %s YEC" % (nodes[USER].getblockcount(), nodes[USER].getbalance()))
    if attest:
        info = rpc(state, USER).yed_getinfo()["attest"]
        print("attestation %s: %d seated, poolFresh %d" % (info["status"], info["seatedCount"], info["poolFresh"]))
    print("wallet: " + " ".join(wallet_command(directory)))

def command_check(args):
    try: check(load(os.path.abspath(args.dir)))
    except Exception as error: print(error, file=sys.stderr); return 1
    print("devnet check passed")
def status(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    roles = ["user", "stock", "pool", "pool", "pool"] + ["attest"] * len(attestors_of(state))
    for index, role in enumerate(roles[:state["num_nodes"]]): print("node%d %-6s rpc %d %s" % (index, role, rpc_port(index), "up" if alive(state, index) else "DOWN"))
    if not alive(state, USER):
        print("node0 is down: no chain state to report (`up --force` rebuilds, `down --wipe` removes the directory)"); return 1
    node = rpc(state, USER); activation, stats = node.yed_getactivation(), node.yed_getstats()
    print("height %d; activation %s; minting %s" % (node.getblockcount(), activation["status"], "allowed" if stats["mintingAllowed"] else "halted"))
    for row in node.yed_listminers(): print("pool %s registered: %s eligible: %s" % (row["payoutAddress"], json.dumps(row["registered"]), json.dumps(row["eligible"])))
    for pool in POOLS:
        miner = rpc(state, pool).yed_getinfo()["miner"] if alive(state, pool) else {}
        print("node%d next tag: %s (quote age %s s)" % (pool, miner.get("quoteKind", "?"), miner.get("quoteAgeSeconds")))
    agents = agent_pids(state)
    if agents:
        for pool, pid in sorted(agents.items()): print("quote agent node%d pid %d %s" % (pool, pid, "up" if agent_alive(pid) else "DOWN"))
        print("mock price file: %s ($%s)" % (mock_path(directory), state["price_usd"]))
    else: print("quotes: set directly (`up --agents` runs the real quote agents)")
    if attestors_of(state):
        attest = node.yed_getinfo()["attest"]
        print("attestation %s (trigger %s, arm %s); seated %d; pool %d, fresh %d; carrier %s; required %s"
              % (attest["status"], attest["triggerHeight"], attest["armHeight"], attest["seatedCount"],
                 attest["poolSize"], attest["poolFresh"], attest["carrierMode"], attest["required"]))
        for rec in node.yed_listattestors():
            print("  seq %-3s %-9s bond %s zat, registered %s, fresh %s"
                  % (rec["seq"], rec["status"], rec["bondZat"], rec["registerHeight"],
                     json.dumps(rec.get("poolFresh"))))
        # The seq a node was given is assigned on chain, in the order the registrations landed in
        # their block -- not in node order. Print it here: reading `node7` as `seq 7` is the
        # mistake this line exists to prevent.
        for attestor in attestors_of(state):
            pid = attest_pids(state).get("attest-%d" % attestor)
            price_file = attest_mock_path(directory, attestor)
            quoted = open(price_file).read().strip() if os.path.exists(price_file) else "?"
            print("  node%d (seq %s) agent pid %s %s, mock price $%s"
                  % (attestor, state.get("attest_seqs", {}).get(str(attestor), "?"),
                     pid, "up" if pid and agent_alive(pid) else "DOWN", quoted))
        pid = attest_pids(state).get("subscribe-%d" % USER)
        print("  subscriber pid %s %s (bus %s)" % (pid, "up" if pid and agent_alive(pid) else "DOWN", bus_path(directory)))
    print("wallet: " + " ".join(wallet_command(directory)))
def mine(args):
    state = load(os.path.abspath(args.dir))
    if not 0 <= args.node < state["num_nodes"]: sys.exit("node must be between 0 and %d" % (state["num_nodes"] - 1))
    node = rpc(state, args.node); start = node.getblockcount(); node.generate(args.blocks)
    sync_blocks([rpc(state, index) for index in range(state["num_nodes"]) if alive(state, index)])
    print("mined %d blocks on node%d: height %d -> %d" % (args.blocks, args.node, start, node.getblockcount()))
def price(args):
    state, value = load(os.path.abspath(args.dir)), Decimal(args.usd)
    if value <= 0: sys.exit("price must be positive")
    if agent_pids(state):
        since = time.time(); write_mock(os.path.abspath(args.dir), value)
        state["price_usd"] = str(value); save(os.path.abspath(args.dir), state)
        try: wait_quotes(state, since)
        except RuntimeError as error: sys.exit(str(error))
        for attestor in attestors_of(state): write_attest_mock(os.path.abspath(args.dir), attestor, value)
        print("set the mock price to $%s; the agents have pushed it, mine a pool block to publish each quote" % value)
        return
    for node in state["pools"]: set_quote(rpc(state, node), value)
    state["price_usd"] = str(value); save(os.path.abspath(args.dir), state)
    for attestor in attestors_of(state): write_attest_mock(os.path.abspath(args.dir), attestor, value)
    print("set pool quotes%s to $%s; mine a pool block to publish each quote"
          % (" and every attestor's mock price" if attestors_of(state) else "", value))
def attestor(args):
    """`attestor N stop|start|price USD`: the outage and divergence demos of v3 section 5.

    stop  -- kill that attestor's agent; with K_SLACK the others still cover a mint, and stopping
             two leaves minting refusing with `missing`.
    start -- bring it back (the node keeps its seat; only the pool goes stale).
    price -- give that one attestor a different mock price, so the GUI shows a diverging source
             and, far enough out, DIVERGE_BPS_ATTEST drops it from the selection."""
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    attestors = attestors_of(state)
    if not attestors: sys.exit("this devnet was brought up with --no-attest; there are no attestors")
    if args.node not in attestors: sys.exit("attestor must be one of %s" % ", ".join(str(a) for a in attestors))
    name = "attest-%d" % args.node
    pid = attest_pids(state).get(name)
    if args.action == "stop":
        if not (pid and agent_alive(pid)): print("%s is already down" % name); return
        stop_attest_agents(state, only=name)
        state["attest_agents"][name] = pid          # remembered so `start` can report the swap
        save(directory, state)
        print("stopped %s (seq %s); its attestations stop at the next tick, and the pool keeps the last "
              "until it ages past attestMaxAge" % (name, state["attest_seqs"].get(str(args.node), "?")))
        return
    if args.action == "start":
        if pid and agent_alive(pid): print("%s is already up (pid %d)" % (name, pid)); return
        seq = state["attest_seqs"][str(args.node)]
        state["attest_agents"][name] = start_attest_agent(directory, args.node, seq)
        save(directory, state)
        print("started %s (pid %d, seq %d); mine %d blocks for its next tick"
              % (name, state["attest_agents"][name], seq, ATTEST_INTERVAL))
        return
    value = Decimal(args.usd)
    if value <= 0: sys.exit("price must be positive")
    write_attest_mock(directory, args.node, value)
    print("node%d (seq %s) now attests $%s (the others are at $%s); mine %d blocks for its next tick"
          % (args.node, state["attest_seqs"].get(str(args.node), "?"), value, state["price_usd"], ATTEST_INTERVAL))

def notice(args):
    """`notice VAULTTXID`: post the emergency claim notice for a vault from node 0 (NOT-1,
    `yed_claimnotice`), the entry point of the emergency flow the GUI demonstrates. Anyone may
    post a notice and it needs YEC, not YED, so node 0 can post one for a vault it does not own.

    Like every bundle-carrying command this is two-step: with `wait` (the default) the call blocks
    until its carrier confirms, so mine a block from another terminal -- `yellowback-devnet mine
    1 2` -- while it waits."""
    state = load(os.path.abspath(args.dir))
    node = rpc(state, USER)
    if not attestors_of(state): sys.exit("this devnet was brought up with --no-attest; there is no notice path")
    try:
        result = node.yed_claimnotice(args.vaulttxid)
    except Exception as error:
        sys.exit("yed_claimnotice: %s" % error)
    if result.get("pending"):
        print("carrier %s is in flight; mine a block and run `notice %s` again"
              % (result["carrierTxid"][:16], args.vaulttxid))
        return
    print("notice posted: txid %s, refHeight %s, emergency claim opens at %s"
          % (result.get("txid", "?"), result.get("refHeight"), result.get("emergencyOpenAt")))

def wallet(args):
    directory, app = os.path.abspath(args.dir), args.app
    command = wallet_command(directory, app)
    if args.print: print(" ".join(command)); return
    if not os.access(command[0], os.X_OK): sys.exit("wallet not found; pass --app or use --print")
    subprocess.Popen(command, stdin=subprocess.DEVNULL, start_new_session=True); print("launched " + " ".join(command))
def cli(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    if args.datadir is not None:
        if not 0 <= args.datadir < state["num_nodes"]: sys.exit("node must be between 0 and %d" % (state["num_nodes"] - 1))
        print(node_dir(directory, args.datadir)); return 0
    return subprocess.call([os.path.join(os.path.dirname(state["bitcoind"]), "ycash-cli"), "-datadir=" + node_dir(directory, args.node)] + args.args)
def down(args):
    directory, state = os.path.abspath(args.dir), load(os.path.abspath(args.dir))
    stop_agents(state); stop_attest_agents(state)
    for node in range(state["num_nodes"]):
        if alive(state, node):
            try: rpc(state, node).stop(); print("stopping node%d" % node)
            except Exception as error: print("node%d: %s" % (node, error))
    if args.wipe: shutil.rmtree(directory); print("wiped %s" % directory)

def main():
    parser = argparse.ArgumentParser(description=__doc__); sub = parser.add_subparsers(dest="command", required=True)
    def add(name, fn):
        command = sub.add_parser(name); command.add_argument("--dir", default=DEFAULT_DIR); command.set_defaults(fn=fn); return command
    command = add("up", up); command.add_argument("--portseed", type=int, default=_default_portseed()); command.add_argument("--price", default="50"); command.add_argument("--bitcoind"); command.add_argument("--force", action="store_true")
    command.add_argument("--agents", action="store_true", help="run one real yellowback-quote --mock-price per pool instead of yed_setquote from this script")
    command.add_argument("--no-attest", action="store_true", help="the five-node v2 devnet: no attestor nodes, no attest agents, never ARMED")
    add("check", command_check); add("status", status)
    command = add("mine", mine); command.add_argument("blocks", type=int); command.add_argument("node", type=int, nargs="?", default=USER)
    command = add("price", price); command.add_argument("usd")
    command = add("attestor", attestor); command.add_argument("node", type=int); command.add_argument("action", choices=("stop", "start", "price")); command.add_argument("usd", nargs="?")
    command = add("notice", notice); command.add_argument("vaulttxid")
    command = add("wallet", wallet); command.add_argument("--app"); command.add_argument("--print", action="store_true")
    command = add("cli", cli); command.add_argument("--node", type=int, default=USER); command.add_argument("--datadir", type=int, metavar="N", help="print node N's datadir and exit"); command.add_argument("args", nargs=argparse.REMAINDER)
    command = add("down", down); command.add_argument("--wipe", action="store_true")
    args = parser.parse_args()
    if args.command == "cli" and args.args[:1] == ["--"]: args.args = args.args[1:]
    if args.command == "attestor" and args.action == "price" and args.usd is None:

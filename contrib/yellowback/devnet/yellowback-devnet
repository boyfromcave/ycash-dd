def banner(state):
    role = role_of(state)
    if role == "none": return "seat: none (the fully automated demo); every node is the devnet's"
    seat = seat_of(state)
    port = state["rpc"][str(seat)]["port"]
    return ("=" * 78 + "\n"
            "  YOUR SEAT: %s -- node%d (rpc port %d): %s\n"
            "  the other nodes are automated; driving them is the single most likely mistake here\n" % (role.upper(), seat, port, ROLES[role]["what"])
            + "=" * 78)

def status(args):

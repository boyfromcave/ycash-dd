    print(banner(state))
    roles = {USER: "user" if role_of(state) in ("none", "user") else "funder", STOCK: "stock"}
    for pool_node in all_pools(state): roles[pool_node] = "pool" if pool_node in auto_pools(state) else "POOL*"

    add("_heartbeat", _heartbeat_run, help=argparse.SUPPRESS); add("_walk", _walk_run, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.command == "cli" and args.args[:1] == ["--"]: args.args = args.args[1:]
    if args.command == "attestor" and args.action == "price" and args.usd is None:
        parser.error("attestor N price needs a USD amount")
    if args.command in ("pool",) and args.action in ("signal", "quote") and args.value is None:
        parser.error("pool N %s needs a value" % args.action)
    return args.fn(args) or 0

if __name__ == "__main__": sys.exit(main())

    node = rpc(state, USER); activation, stats = node.yed_getactivation(), node.yed_getstats()
    mintable = stats.get("mintableClasses")
    minting = ("allowed" if stats["mintingAllowed"] else
               "limited to class %s (%s; W16)" % (", ".join(mintable), ",".join(stats.get("haltMask") or [])) if mintable else
               "halted (%s)" % ",".join(stats.get("haltMask") or []))
    print("height %d; activation %s; minting %s; global ratio %s; supply %s YED in %d active vault(s)"
          % (node.getblockcount(), activation["status"], minting,
             "undefined" if stats.get("globalRatioBps") is None else "%.1f %%" % (stats["globalRatioBps"] / 100),
             Decimal(stats["supplyCents"]) / 100, stats["activeVaults"]))
    if role_of(state) != "none": print(heartbeat_line(state))
    walk = state.get("walk") or {}
    print("price: $%s%s" % (read_mock(directory), (" walking (pid %d, drift %+.2f %%/min, vol %.2f %%/tick)" % (walk["pid"], walk["drift"], walk["vol"]))
                                                  if agent_alive(walk.get("pid")) else " (fixed; `price --walk` starts the walk)"))
    for row in node.yed_listminers(): print("pool %s registered: %s eligible: %s share %s" % (row["payoutAddress"], json.dumps(row["registered"]), json.dumps(row["eligible"]), row.get("share")))
    for pool_node in all_pools(state):
        miner = rpc(state, pool_node).yed_getinfo()["miner"] if alive(state, pool_node) else {}
        print("node%d next tag: %s (quote age %s s, signal %s)%s" % (pool_node, miner.get("quoteKind", "?"), miner.get("quoteAgeSeconds"), json.dumps(miner.get("signal")),
                                                                     "   <- you" if role_of(state) == "pool" and pool_node == seat_of(state) else ""))
    agents = agent_pids(state)
    if agents:
        for pool_node, pid in sorted(agents.items()): print("quote agent node%d pid %d %s" % (pool_node, pid, "up" if agent_alive(pid) else "DOWN"))
        print("mock price file: %s" % mock_path(directory))
    else: print("quotes: set directly (`up --agents` runs the real quote agents)")
    if attestors_of(state):
        attest = node.yed_getinfo()["attest"]
        print("attestation %s (trigger %s, arm %s); seated %d; pool %d, fresh %d; carrier %s; required %s"
              % (attest["status"], attest["triggerHeight"], attest["armHeight"], attest["seatedCount"],
                 attest["poolSize"], attest["poolFresh"], attest["carrierMode"], attest["required"]))
        for rec in node.yed_listattestors():
            print("  seq %-3s %-9s bond %s zat, registered %s, seated %s, fresh %s, pinned %s"
                  % (rec["seq"], rec["status"], rec["bondZat"], rec["registerHeight"], json.dumps(rec.get("seated")),
                     json.dumps(rec.get("poolFresh")), json.dumps(rec.get("pinned"))))
        # The seq a node was given is assigned on chain, in the order the registrations landed in
        # their block -- not in node order. Print it here: reading `node7` as `seq 7` is the
        # mistake this line exists to prevent.
        for attestor in attestors_of(state):
            pid = attest_pids(state).get("attest-%d" % attestor)
            price_file = attest_mock_path(directory, attestor)
            quoted = open(price_file).read().strip() if os.path.exists(price_file) else "?"
            print("  node%d (seq %s) agent pid %s %s, mock price $%s"
                  % (attestor, state.get("attest_seqs", {}).get(str(attestor), "?"),

def _default_dir():
    return os.path.expanduser(os.environ.get("YELLOWBACK_DEVNET_DIR") or "~/yb-devnet")

def _default_portseed():
    """The plan (v3 section 5) names YELLOWBACK_DEVNET_PORTBASE, but every port here comes from
    the inherited framework's PortSeed (test_framework/util.py:89) -- PORT_MIN + n + a function of
    the seed -- not from a base. The seed is the real knob, so PORTSEED is read first and a
    PORTBASE is folded into a distinct seed rather than rejected: two devnets started by the
    plan's text still land on disjoint ports. See docs/mapping.md section 13.4."""
    seed = os.environ.get("YELLOWBACK_DEVNET_PORTSEED")
    if seed: return int(seed)
    base = os.environ.get("YELLOWBACK_DEVNET_PORTBASE")
    if base: return int(base) % 4096
    return 7

DEFAULT_DIR = _default_dir()

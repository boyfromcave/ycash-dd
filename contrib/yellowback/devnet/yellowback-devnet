def path(directory): return os.path.join(directory, "devnet.json")
def node_dir(directory, node): return os.path.join(directory, "node%d" % node)
def rpc(state, node): return get_rpc_proxy(rpc_url(node), node, timeout=30)
def alive(state, node):
    try: rpc(state, node).getblockcount(); return True
    except Exception: return False
def mock_path(directory): return os.path.join(directory, "mock-price")
def agent_pids(state): return {int(k): v for k, v in (state.get("agents") or {}).items()}
def agent_alive(pid):
    try: os.kill(pid, 0); return True
    except OSError: return False
def write_mock(directory, usd):
    tmp = mock_path(directory) + ".tmp"
    with open(tmp, "w") as file: file.write("%s\n" % usd)
    os.replace(tmp, mock_path(directory))
def start_agent(directory, node):
    """One yellowback-quote per pool, detached, reading the shared mock price file; returns its pid."""
    user, password = rpc_auth_pair(node)
    conf = os.path.join(directory, "quote-%d.toml" % node)
    with open(conf, "w") as file: file.write(AGENT_CONF % {"node": node, "port": rpc_port(node), "user": user, "password": password})
    log = open(os.path.join(directory, "quote-%d.log" % node), "a")
    process = subprocess.Popen([sys.executable, AGENT, "--conf", conf, "--mock-price", mock_path(directory)],
                               stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    log.close()
    return process.pid
def stop_agents(state):
    for node, pid in agent_pids(state).items():
        if agent_alive(pid):
            try: os.kill(pid, 15); print("stopping quote agent of node%d (pid %d)" % (node, pid))
            except OSError as error: print("agent of node%d: %s" % (node, error))
def wait_quotes(state, since=None, timeout=60):
    """Wait until every pool's next tag is a quote; with `since` (a wall-clock time), until each
    pool's quote was stamped at least two seconds after it, so the agents have re-read the mock."""
    deadline = time.time() + timeout
    while True:
        miners = {node: rpc(state, node).yed_getinfo()["miner"] for node in POOLS}
        def fresh(miner):
            if miner["quoteKind"] != "quote": return False
            return since is None or (time.time() - since) - miner["quoteAgeSeconds"] >= 2
        if all(fresh(miner) for miner in miners.values()): return
        if time.time() > deadline: raise RuntimeError("quote agents did not publish within %ds: %s" % (timeout, {node: miner["quoteKind"] for node, miner in miners.items()}))
        time.sleep(0.5)
def bus_path(directory): return os.path.join(directory, "attest-bus")
def attest_mock_path(directory, node): return os.path.join(directory, "attest-price-%d" % node)
def attest_pids(state): return {k: v for k, v in (state.get("attest_agents") or {}).items()}
def attestors_of(state): return tuple(state.get("attestors") or ())

def write_attest_mock(directory, node, usd):
    tmp = attest_mock_path(directory, node) + ".tmp"
    with open(tmp, "w") as file: file.write("%s\n" % usd)
    os.replace(tmp, attest_mock_path(directory, node))

def _spawn(directory, name, argv):
    """One detached agent process logging to <dir>/<name>.log; returns its pid."""
    log = open(os.path.join(directory, "%s.log" % name), "a")
    process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log,
                               stderr=subprocess.STDOUT, start_new_session=True)
    log.close()
    return process.pid

def start_attest_agent(directory, node, seq):
    """`yellowback-attest attest` beside attestor `node`, reading that attestor's own mock price
    file so `attestor N price USD` can diverge one of them."""
    user, password = rpc_auth_pair(node)
    conf = os.path.join(directory, "attest-%d.toml" % node)
    with open(conf, "w") as file:
        file.write(ATTEST_CONF % {"node": node, "port": rpc_port(node), "user": user, "password": password,
                                  "seq": seq, "every": ATTEST_INTERVAL, "ref_lag": REF_LAG, "bus": bus_path(directory)})
    return _spawn(directory, "attest-%d" % node,
                  [ATTEST_AGENT, "--conf", conf, "attest", "--mock-price", attest_mock_path(directory, node)])

def start_subscriber(directory, node=USER):
    """`yellowback-attest subscribe` beside node 0: the dir bus into yed_addattestation."""
    user, password = rpc_auth_pair(node)
    conf = os.path.join(directory, "subscribe-%d.toml" % node)
    with open(conf, "w") as file:
        file.write(SUBSCRIBE_CONF % {"node": node, "port": rpc_port(node), "user": user,
                                     "password": password, "bus": bus_path(directory)})
    return _spawn(directory, "subscribe-%d" % node, [ATTEST_AGENT, "--conf", conf, "subscribe"])

def stop_attest_agents(state, only=None):
    """Stop every attest agent, or just the one named `only` (`attest-5`, `subscribe-0`)."""
    for name, pid in sorted(attest_pids(state).items()):
        if only is not None and name != only: continue
        if agent_alive(pid):
            try: os.kill(pid, 15); print("stopping %s (pid %d)" % (name, pid))
            except OSError as error: print("%s: %s" % (name, error))

def wait_pool_fresh(state, want=None, timeout=90):
    """Wait until node 0's pool holds a fresh attestation from at least `want` seated attestors --
    what the mint path needs (attest.poolFresh >= M_SELECT)."""
    want = M_SELECT if want is None else want
    deadline, last = time.time() + timeout, None
    while True:
        last = rpc(state, USER).yed_getinfo()["attest"]
        if last["poolFresh"] >= want: return last
        if time.time() > deadline:
            raise RuntimeError("poolFresh stayed at %d (< %d) for %ds; see %s/attest-*.log and subscribe-*.log"
                               % (last["poolFresh"], want, timeout, state["dir"]))
        time.sleep(1)

def seq_of(node_rpc, attestor_pubkey):
    """yed_registerattestor returns seq null until the registration confirms; resolve it by key."""
    for rec in node_rpc.yed_listattestors():
        if rec["attestorPubKey"] == attestor_pubkey: return int(rec["seq"])
    return None

def load(directory):
    try:
        with open(path(directory)) as file: state = json.load(file)
    except OSError: sys.exit("no devnet at %s (run `up` first)" % directory)
    PortSeed.n = state["portseed"]
    return state
def save(directory, state):
    with open(path(directory), "w") as file: json.dump(state, file, indent=2)

def start_quiet(directory, node, arguments):
    import functools
    import test_framework.util as util
    log = open(os.path.join(node_dir(directory, node), "ycashd.log"), "a")
    output, popen = os.dup(1), util.subprocess.Popen
    util.subprocess.Popen = functools.partial(popen, start_new_session=True, stdin=subprocess.DEVNULL)
    try:
        os.dup2(log.fileno(), 1)
        return start_node(node, directory, arguments, stderr=log)
    finally:
        util.subprocess.Popen = popen
        os.dup2(output, 1); os.close(output); log.close()


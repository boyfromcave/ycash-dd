def path(directory): return os.path.join(directory, "devnet.json")
def node_dir(directory, node): return os.path.join(directory, "node%d" % node)
def rpc(state, node, timeout=30):
    url = (state.get("rpc") or {}).get(str(node), {}).get("url") or rpc_url(node)
    return get_rpc_proxy(url, node, timeout=timeout)
def alive(state, node):
    try: rpc(state, node).getblockcount(); return True
    except Exception: return False
def mock_path(directory): return os.path.join(directory, "mock-price")
def agent_pids(state): return {int(k): v for k, v in (state.get("agents") or {}).items()}
def agent_alive(pid):
    if not pid: return False
    try: os.kill(pid, 0); return True
    except OSError: return False
def read_mock(directory):
    try: return Decimal(open(mock_path(directory)).read().strip())
    except (OSError, ArithmeticError): return None
def write_mock(directory, usd):
    tmp = mock_path(directory) + ".tmp"
    with open(tmp, "w") as file: file.write("%s\n" % usd)
    os.replace(tmp, mock_path(directory))
def role_of(state): return state.get("role") or "none"
def seat_of(state): return state.get("seat", USER)
def auto_pools(state): return tuple(state.get("auto_pools") or POOLS)
def all_pools(state): return tuple(state.get("pools") or POOLS)
def auto_attestors(state): return tuple(state.get("auto_attestors") or attestors_of(state))
def attestors_of(state): return tuple(state.get("attestors") or ())
def minting_nodes(state):
    """The nodes that carry a subscriber: every wallet that builds bundles from its own pool."""
    nodes = [USER]
    for key in ("population", "liquidator"):
        if state.get(key) is not None: nodes.append(state[key])
    return nodes
def pool_address(state, node):
    return state["pool_addresses"][all_pools(state).index(node)]

def start_agent(directory, node):
    """One yellowback-quote per pool, detached, reading the shared mock price file; returns its pid."""
    user, password = rpc_auth_pair(node)
    conf = os.path.join(directory, "quote-%d.toml" % node)
    with open(conf, "w") as file: file.write(AGENT_CONF % {"node": node, "port": rpc_port(node), "user": user, "password": password})
    return _spawn(directory, "quote-%d" % node, [sys.executable, AGENT, "--conf", conf, "--mock-price", mock_path(directory)])
def stop_agents(state, only=None):
    for node, pid in agent_pids(state).items():
        if only is not None and node != only: continue
        if agent_alive(pid):
            try: os.kill(pid, 15); print("stopping quote agent of node%d (pid %d)" % (node, pid))
            except OSError as error: print("agent of node%d: %s" % (node, error))
def wait_quotes(state, since=None, timeout=60, pools=None):
    """Wait until every automated pool's next tag is a quote; with `since` (a wall-clock time),
    until each pool's quote was stamped at least two seconds after it, so the agents have re-read
    the mock."""
    pools = auto_pools(state) if pools is None else pools
    deadline = time.time() + timeout
    while True:
        miners = {node: rpc(state, node).yed_getinfo()["miner"] for node in pools}
        def fresh(miner):
            if miner["quoteKind"] != "quote": return False
            return since is None or (time.time() - since) - miner["quoteAgeSeconds"] >= 2
        if all(fresh(miner) for miner in miners.values()): return
        if time.time() > deadline: raise RuntimeError("quote agents did not publish within %ds: %s" % (timeout, {node: miner["quoteKind"] for node, miner in miners.items()}))
        time.sleep(0.5)
def bus_path(directory): return os.path.join(directory, "attest-bus")
def attest_mock_path(directory, node): return os.path.join(directory, "attest-price-%d" % node)
def attest_pids(state): return {k: v for k, v in (state.get("attest_agents") or {}).items()}

def write_attest_mock(directory, node, usd):
    tmp = attest_mock_path(directory, node) + ".tmp"
    with open(tmp, "w") as file: file.write("%s\n" % usd)
    os.replace(tmp, attest_mock_path(directory, node))

def _spawn(directory, name, argv, env=None):
    """One detached agent process logging to <dir>/<name>.log; returns its pid."""
    log = open(os.path.join(directory, "%s.log" % name), "a")
    process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log, env=env,
                               stderr=subprocess.STDOUT, start_new_session=True)
    log.close()
    return process.pid

def mark_stopped(state, name, stopped):
    """Record a deliberate stop (`attestor N stop`, `pool N quote stop`) so the heartbeat's
    liveness check and `check` do not read the dead process as a broken devnet."""
    names = set(state.get("stopped_agents") or [])
    (names.add if stopped else names.discard)(name)
    state["stopped_agents"] = sorted(names)

def _kill(pid, label):
    if agent_alive(pid):
        try: os.kill(pid, 15); print("stopping %s (pid %d)" % (label, pid))
        except OSError as error: print("%s: %s" % (label, error))


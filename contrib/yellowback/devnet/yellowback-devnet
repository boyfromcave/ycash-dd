        print("node%-2d %-7s rpc %d %s%s" % (index, roles.get(index, "?"), state.get("rpc", {}).get(str(index), {}).get("port", rpc_port(index)),
                                            "up" if alive(state, index) else "DOWN", "   <- you" if role_of(state) != "none" and index == seat_of(state) else ""))
    if not alive(state, USER):

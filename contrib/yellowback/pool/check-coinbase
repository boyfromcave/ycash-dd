"""
check-coinbase: does this block carry a Yellowback coinbase tag? (plan §5 step 4)

  check-coinbase <height|blockhash> [-- <ycash-cli options>]     # e.g. -- -regtest -datadir=/x
  check-coinbase --scriptsig <hex>                               # decode a raw coinbase scriptSig offline

Reads the block's coinbase scriptSig through `ycash-cli getblock` and
`getrawtransaction` and decodes it with the same TAG-1..5 rules the node
uses (yellowback_price.decode_coinbase_tag). Prints one `key: value` line per
field, always starting with `kind: quote|signal|none`. Exit 0 when a tag was
found, 1 when none, 2 on an error. `--json` prints a JSON object instead.

Everything after `--` is passed to ycash-cli verbatim (network, datadir, rpc
options); `--cli PATH` names the binary (default: ycash-cli on PATH).
"""

import argparse
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import yellowback_price as yp  # noqa: E402


def cli(binary, extra, *args):
    cmd = [binary] + list(extra) + list(args)
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        raise RuntimeError("%s: %s" % (" ".join(cmd[:1] + list(args)), (p.stderr or p.stdout).strip()))
    return p.stdout


def coinbase_scriptsig(binary, extra, block):
    blk = json.loads(cli(binary, extra, "getblock", str(block)))
    if not blk.get("tx"):
        raise RuntimeError("block has no transactions")
    tx = json.loads(cli(binary, extra, "getrawtransaction", blk["tx"][0], "1"))
    vin = tx.get("vin") or []
    if not vin or "coinbase" not in vin[0]:
        raise RuntimeError("first transaction is not a coinbase")
    return blk.get("height"), blk.get("hash"), bytes.fromhex(vin[0]["coinbase"])


def describe(script_sig, height=None, blockhash=None):
    tag = yp.decode_coinbase_tag(script_sig)
    out = {"kind": tag["kind"] if tag else "none", "found": tag is not None}
    if height is not None:
        out["height"] = height
    if blockhash is not None:
        out["blockhash"] = blockhash
    out["scriptSigBytes"] = len(script_sig)
    if tag:
        out.update({"version": tag["version"], "signal": tag["signal"], "priceMicroUsd": tag["priceMicroUsd"],
                    "priceUsd": tag["priceMicroUsd"] / yp.MICRO, "sourceMask": tag["sourceMask"],
                    "payoutKeyHash160": tag["payoutKeyHex"], "offset": tag["offset"]})
    return out


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    extra = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(prog="check-coinbase", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("block", nargs="?", help="height or block hash")
    ap.add_argument("--scriptsig", help="hex of a coinbase scriptSig to decode offline")
    ap.add_argument("--cli", default="ycash-cli")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)
    try:
        if args.scriptsig:
            out = describe(bytes.fromhex(args.scriptsig))
        elif args.block:
            height, blockhash, ss = coinbase_scriptsig(args.cli, extra, args.block)
            out = describe(ss, height, blockhash)
        else:
            ap.error("give a height/blockhash or --scriptsig")
    except (RuntimeError, ValueError, OSError) as e:
        print("error: %s" % e, file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(out))
    else:
        for k, v in out.items():
            print("%s: %s" % (k, json.dumps(v) if isinstance(v, bool) else v))
    return 0 if out["found"] else 1


if __name__ == "__main__":
    sys.exit(main())
